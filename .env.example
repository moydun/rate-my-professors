SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=*
# Comma-separated HTTPS origins trusted for CSRF (production only; empty is fine for local dev).
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=postgres://proflens:proflens@localhost:5432/proflens
REPO_BACKEND=memory

# Security hardening (defaults track DEBUG: enabled when DEBUG=False).
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_REFERRER_POLICY=same-origin

# Rate limiting (cache-backed fixed windows). Use a shared cache in production.
RATELIMIT_ENABLE=True
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=proflens
